// FreelanceOS — Phase 0/1 schema: tenancy, identity, CRM, pipeline, audit, config.
// Rules from the PRD that shape this file:
//  - every business row carries workspaceId (future multi-tenant SaaS)
//  - money = BigInt minor units + currency code, never floats
//  - archive, never cascade-delete, historical records
//  - audit events are append-only (enforced by a DB trigger in the first migration)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Identity & access ─────────────────────────

enum WorkspaceRole {
  OWNER
  ADMIN
  PROJECT_MANAGER
  FINANCE_MANAGER
  COLLABORATOR
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique // stored lower-cased by the application
  passwordHash String
  name         String
  disabledAt   DateTime? @db.Timestamptz
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz

  memberships WorkspaceMembership[]
  sessions    UserSession[]

  @@map("users")
}

model Workspace {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  legalName       String?
  email           String?
  phone           String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  region          String?
  postalCode      String?
  country         String?  @db.Char(2) // ISO 3166-1 alpha-2
  taxIdentifier   String? // e.g. GSTIN; not assumed to be Indian
  defaultCurrency String   @default("INR") @db.Char(3)
  timezone        String   @default("Asia/Kolkata")
  locale          String   @default("en-IN")
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz

  memberships     WorkspaceMembership[]
  settings        WorkspaceSettings?
  clients         Client[]
  pipelineStages  PipelineStage[]
  engagements     Engagement[]
  auditEvents     AuditEvent[]
  numberSequences NumberSequence[]
  templates       DocumentTemplate[]
  proposals       Proposal[]
  agreements      Agreement[]
  projects        Project[]
  invoices        Invoice[]
  payments        Payment[]

  @@map("workspaces")
}

model WorkspaceMembership {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_memberships")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique // sha-256 of the opaque refresh token
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now()) @db.Timestamptz
  lastUsedAt       DateTime  @default(now()) @db.Timestamptz
  expiresAt        DateTime  @db.Timestamptz
  revokedAt        DateTime? @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@map("user_sessions")
}

// ───────────────────────── Configuration ─────────────────────────

enum NumberingScope {
  WORKSPACE // one continuous sequence
  FINANCIAL_YEAR // resets every April (Indian FY)
}

model WorkspaceSettings {
  workspaceId             String         @id @db.Uuid
  invoicePrefix           String         @default("INV")
  invoiceNumbering        NumberingScope @default(FINANCIAL_YEAR)
  invoicePadding          Int            @default(4)
  defaultPaymentTermsDays Int            @default(30)
  defaultTaxBps           Int            @default(1800)
  updatedAt               DateTime       @updatedAt @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@map("workspace_settings")
}

/// Gap-free, concurrency-safe counters. Incremented with a single
/// INSERT … ON CONFLICT DO UPDATE … RETURNING statement (see NumberSequenceService).
model NumberSequence {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  key         String // e.g. "INVOICE", "PROPOSAL"
  scope       String @default("") // e.g. "26-27" for a financial-year scope
  lastValue   Int    @default(0)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, key, scope])
  @@map("number_sequences")
}

model Currency {
  code     String @id @db.Char(3)
  name     String
  exponent Int // minor-unit digits: INR 2, JPY 0, KWD 3

  @@map("currencies")
}

/// Historical rates are append-only; a transaction stores the rate used at the time.
model ExchangeRate {
  id            String   @id @default(uuid()) @db.Uuid
  baseCurrency  String   @db.Char(3)
  quoteCurrency String   @db.Char(3)
  rate          Decimal  @db.Decimal(20, 10)
  asOf          DateTime @db.Date
  source        String
  createdAt     DateTime @default(now()) @db.Timestamptz

  @@unique([baseCurrency, quoteCurrency, asOf, source])
  @@map("exchange_rates")
}

// ───────────────────────── CRM ─────────────────────────

enum ClientType {
  COMPANY
  INDIVIDUAL
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Client {
  id            String       @id @default(uuid()) @db.Uuid
  workspaceId   String       @db.Uuid
  type          ClientType
  name          String
  status        ClientStatus @default(ACTIVE)
  email         String?
  phone         String?
  website       String?
  taxIdentifier String?
  notes         String?
  tags          String[]     @default([])
  archivedAt    DateTime?    @db.Timestamptz
  createdAt     DateTime     @default(now()) @db.Timestamptz
  updatedAt     DateTime     @updatedAt @db.Timestamptz

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  contacts     ClientContact[]
  addresses    ClientAddress[]
  interactions ClientInteraction[]
  engagements  Engagement[]
  proposals    Proposal[]
  agreements   Agreement[]
  projects     Project[]
  invoices     Invoice[]
  payments     Payment[]

  @@index([workspaceId, status])
  @@index([workspaceId, name])
  @@map("clients")
}

model ClientContact {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  clientId    String    @db.Uuid
  firstName   String
  lastName    String?
  email       String?
  phone       String?
  jobTitle    String?
  isPrimary   Boolean   @default(false) // at most one per client: partial unique index in migration
  notes       String?
  archivedAt  DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([workspaceId, clientId])
  @@index([workspaceId, email])
  @@map("client_contacts")
}

enum AddressKind {
  BILLING
  SERVICE
}

model ClientAddress {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @db.Uuid
  clientId    String      @db.Uuid
  kind        AddressKind
  line1       String
  line2       String?
  city        String?
  region      String?
  postalCode  String?
  country     String      @db.Char(2)
  isDefault   Boolean     @default(false)
  createdAt   DateTime    @default(now()) @db.Timestamptz

  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([workspaceId, clientId])
  @@map("client_addresses")
}

enum InteractionType {
  NOTE
  CALL
  EMAIL
  MEETING
}

model ClientInteraction {
  id          String          @id @default(uuid()) @db.Uuid
  workspaceId String          @db.Uuid
  clientId    String          @db.Uuid
  type        InteractionType
  summary     String
  occurredAt  DateTime        @db.Timestamptz
  authorId    String          @db.Uuid
  createdAt   DateTime        @default(now()) @db.Timestamptz

  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([workspaceId, clientId, occurredAt])
  @@map("client_interactions")
}

// ───────────────────────── Engagements & pipeline ─────────────────────────

enum StageKind {
  OPEN
  WON
  LOST
  ON_HOLD
}

/// Configurable per workspace (PRD §7.4, P1 configurable stages — seeded on setup).
model PipelineStage {
  id             String    @id @default(uuid()) @db.Uuid
  workspaceId    String    @db.Uuid
  name           String
  kind           StageKind @default(OPEN)
  position       Int
  probabilityBps Int       @default(0) // forecast weight, 10000 = 100%
  archivedAt     DateTime? @db.Timestamptz

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  engagements Engagement[]

  @@unique([workspaceId, name])
  @@index([workspaceId, position])
  @@map("pipeline_stages")
}

model Engagement {
  id                  String    @id @default(uuid()) @db.Uuid
  workspaceId         String    @db.Uuid
  clientId            String    @db.Uuid
  stageId             String    @db.Uuid
  ownerId             String    @db.Uuid
  title               String
  description         String?
  serviceCategory     String?
  source              String?
  estimatedValueMinor BigInt    @default(0)
  currency            String    @db.Char(3)
  expectedStartDate   DateTime? @db.Date
  expectedCloseDate   DateTime? @db.Date
  lostReason          String?
  followUpAt          DateTime? @db.Date
  archivedAt          DateTime? @db.Timestamptz
  createdAt           DateTime  @default(now()) @db.Timestamptz
  updatedAt           DateTime  @updatedAt @db.Timestamptz

  workspace    Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  client       Client                   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  stage        PipelineStage            @relation(fields: [stageId], references: [id], onDelete: Restrict)
  requirements EngagementRequirement[]
  stageHistory EngagementStageHistory[]
  proposals    Proposal[]
  agreements   Agreement[]
  projects     Project[]

  @@index([workspaceId, stageId])
  @@index([workspaceId, clientId])
  @@map("engagements")
}

enum RequirementKind {
  REQUIREMENT
  DISCOVERY_NOTE
}

model EngagementRequirement {
  id           String          @id @default(uuid()) @db.Uuid
  workspaceId  String          @db.Uuid
  engagementId String          @db.Uuid
  kind         RequirementKind @default(REQUIREMENT)
  title        String
  detail       String?
  position     Int             @default(0)
  createdAt    DateTime        @default(now()) @db.Timestamptz

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Restrict)

  @@index([workspaceId, engagementId])
  @@map("engagement_requirements")
}

model EngagementStageHistory {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @db.Uuid
  engagementId String   @db.Uuid
  fromStageId  String?  @db.Uuid
  toStageId    String   @db.Uuid
  actorId      String   @db.Uuid
  reason       String?
  createdAt    DateTime @default(now()) @db.Timestamptz

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Restrict)

  @@index([workspaceId, engagementId, createdAt])
  @@map("engagement_stage_history")
}

// ───────────────────────── Audit ─────────────────────────

enum AuditActorType {
  USER
  CLIENT_CONTACT
  SYSTEM
}

/// Append-only. UPDATE and DELETE are rejected by a trigger (see migration).
/// Targets are (type, id) pairs because an audit trail legitimately spans every
/// record type; it is never used for authorization or joins on critical paths.
model AuditEvent {
  id            String         @id @default(uuid()) @db.Uuid
  workspaceId   String         @db.Uuid
  actorType     AuditActorType @default(USER)
  actorId       String?        @db.Uuid
  action        String // e.g. "client.created", "engagement.stage_changed"
  targetType    String
  targetId      String         @db.Uuid
  objectVersion Int?
  metadata      Json?
  ipAddress     String?
  createdAt     DateTime       @default(now()) @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, targetType, targetId])
  @@map("audit_events")
}

// ───────────────────────── Phase 2: commercial documents ─────────────────────────

enum TemplateKind {
  PROPOSAL
  AGREEMENT
}

/// Reusable starting points. `body` is { sections: [...] } for proposals, { clauses: [...] } for agreements.
model DocumentTemplate {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @db.Uuid
  kind        TemplateKind
  name        String
  description String?
  body        Json
  archivedAt  DateTime?    @db.Timestamptz
  createdAt   DateTime     @default(now()) @db.Timestamptz
  updatedAt   DateTime     @updatedAt @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, kind, name])
  @@map("document_templates")
}

enum ProposalStatus {
  DRAFT
  SHARED
  ACCEPTED
  REJECTED
  CHANGES_REQUESTED
}

enum ProposalVersionStatus {
  DRAFT
  SHARED
  SUPERSEDED
  ACCEPTED
  REJECTED
  CHANGES_REQUESTED
}

enum PricingModel {
  FIXED
  MILESTONE
  HOURLY
  DAILY
  TIME_AND_MATERIALS
  RETAINER
  HYBRID
}

enum SectionKind {
  INTRODUCTION
  SCOPE
  DELIVERABLES
  TIMELINE
  ASSUMPTIONS
  EXCLUSIONS
  TERMS
  CUSTOM
}

enum PaymentTermKind {
  UPFRONT
  MILESTONE
  ON_COMPLETION
  NET_DAYS
}

enum DecisionKind {
  ACCEPTED
  REJECTED
  CHANGES_REQUESTED
}

enum DecisionChannel {
  PORTAL
  EMAIL
  MEETING
  OTHER
}

/// Identity of a proposal. Content lives in immutable-once-shared versions (PRD §7.5).
model Proposal {
  id                String         @id @default(uuid()) @db.Uuid
  workspaceId       String         @db.Uuid
  clientId          String         @db.Uuid
  engagementId      String?        @db.Uuid
  number            String
  title             String
  status            ProposalStatus @default(DRAFT)
  acceptedVersionId String?        @db.Uuid
  createdById       String         @db.Uuid
  archivedAt        DateTime?      @db.Timestamptz
  createdAt         DateTime       @default(now()) @db.Timestamptz
  updatedAt         DateTime       @updatedAt @db.Timestamptz

  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  client          Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  engagement      Engagement?        @relation(fields: [engagementId], references: [id], onDelete: Restrict)
  versions        ProposalVersion[]  @relation("ProposalVersions")
  acceptedVersion ProposalVersion?   @relation("AcceptedVersion", fields: [acceptedVersionId], references: [id], onDelete: Restrict)
  decisions       ProposalDecision[]
  agreements      Agreement[]
  projects        Project[]

  @@unique([workspaceId, number])
  @@index([workspaceId, clientId])
  @@index([workspaceId, status])
  @@map("proposals")
}

model ProposalVersion {
  id            String                @id @default(uuid()) @db.Uuid
  workspaceId   String                @db.Uuid
  proposalId    String                @db.Uuid
  versionNumber Int
  status        ProposalVersionStatus @default(DRAFT)
  currency      String                @db.Char(3)
  pricingModel  PricingModel          @default(FIXED)
  validUntil    DateTime?             @db.Date
  summary       String?
  subtotalMinor BigInt                @default(0)
  discountMinor BigInt                @default(0)
  taxMinor      BigInt                @default(0)
  totalMinor    BigInt                @default(0)
  sharedAt      DateTime?             @db.Timestamptz
  sharedById    String?               @db.Uuid
  createdById   String                @db.Uuid
  createdAt     DateTime              @default(now()) @db.Timestamptz

  proposal     Proposal              @relation("ProposalVersions", fields: [proposalId], references: [id], onDelete: Restrict)
  acceptedFor  Proposal[]            @relation("AcceptedVersion")
  sections     ProposalSection[]
  lineItems    ProposalLineItem[]
  paymentTerms ProposalPaymentTerm[]
  decision     ProposalDecision?
  agreements   Agreement[]

  @@unique([proposalId, versionNumber])
  @@index([workspaceId, proposalId])
  @@map("proposal_versions")
}

model ProposalSection {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @db.Uuid
  versionId   String      @db.Uuid
  position    Int
  kind        SectionKind @default(CUSTOM)
  title       String
  body        String      @default("")

  version ProposalVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@index([versionId, position])
  @@map("proposal_sections")
}

model ProposalLineItem {
  id            String  @id @default(uuid()) @db.Uuid
  workspaceId   String  @db.Uuid
  versionId     String  @db.Uuid
  position      Int
  description   String
  quantity      Decimal @db.Decimal(18, 4)
  unitLabel     String  @default("unit")
  unitRateMinor BigInt
  discountBps   Int     @default(0)
  taxBps        Int     @default(0)
  netMinor      BigInt // computed server-side with @freelanceos/shared and stored for history
  taxMinor      BigInt

  version ProposalVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@index([versionId, position])
  @@map("proposal_line_items")
}

model ProposalPaymentTerm {
  id            String          @id @default(uuid()) @db.Uuid
  workspaceId   String          @db.Uuid
  versionId     String          @db.Uuid
  position      Int
  label         String
  kind          PaymentTermKind
  percentageBps Int?
  amountMinor   BigInt?
  dueInDays     Int?

  version ProposalVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@index([versionId, position])
  @@map("proposal_payment_terms")
}

/// A decision references the exact version it was made on, and never changes (trigger-enforced).
/// Until the client portal exists (Phase 5) the owner records decisions received by email/meeting,
/// with channel + note as evidence; `recordedById` always names who entered it.
model ProposalDecision {
  id           String          @id @default(uuid()) @db.Uuid
  workspaceId  String          @db.Uuid
  proposalId   String          @db.Uuid
  versionId    String          @unique @db.Uuid
  decision     DecisionKind
  channel      DecisionChannel @default(OTHER)
  decidedAt    DateTime        @db.Timestamptz
  recordedById String          @db.Uuid
  note         String?
  createdAt    DateTime        @default(now()) @db.Timestamptz

  proposal Proposal        @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  version  ProposalVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@index([workspaceId, proposalId])
  @@map("proposal_decisions")
}

enum AgreementStatus {
  DRAFT
  SENT
  VIEWED
  PARTIALLY_SIGNED
  SIGNED
  DECLINED
  EXPIRED
  VOIDED
}

enum AgreementVersionStatus {
  DRAFT
  SENT
  SIGNED
  DECLINED
  VOID
}

enum SignerRole {
  FREELANCER
  CLIENT
  WITNESS
}

enum SignerStatus {
  PENDING
  SIGNED
  DECLINED
}

enum SignatureEventType {
  SENT
  VIEWED
  SIGNED
  DECLINED
  VOIDED
}

/// MANUAL_RECORDED = the owner records a signature obtained outside the system (evidence note required).
/// PROVIDER = a validated e-signature provider event. Neither is claimed to be legally sufficient (PRD §7.6).
enum SignatureMethod {
  MANUAL_RECORDED
  PROVIDER
}

model Agreement {
  id                String          @id @default(uuid()) @db.Uuid
  workspaceId       String          @db.Uuid
  clientId          String          @db.Uuid
  engagementId      String?         @db.Uuid
  proposalId        String?         @db.Uuid
  proposalVersionId String?         @db.Uuid
  templateId        String?         @db.Uuid
  number            String
  title             String
  status            AgreementStatus @default(DRAFT)
  expiresAt         DateTime?       @db.Date
  voidReason        String?
  createdById       String          @db.Uuid
  archivedAt        DateTime?       @db.Timestamptz
  createdAt         DateTime        @default(now()) @db.Timestamptz
  updatedAt         DateTime        @updatedAt @db.Timestamptz

  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  client          Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  engagement      Engagement?        @relation(fields: [engagementId], references: [id], onDelete: Restrict)
  proposal        Proposal?          @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  proposalVersion ProposalVersion?   @relation(fields: [proposalVersionId], references: [id], onDelete: Restrict)
  versions        AgreementVersion[]
  projects        Project[]

  @@unique([workspaceId, number])
  @@index([workspaceId, clientId])
  @@index([workspaceId, status])
  @@map("agreements")
}

model AgreementVersion {
  id            String                 @id @default(uuid()) @db.Uuid
  workspaceId   String                 @db.Uuid
  agreementId   String                 @db.Uuid
  versionNumber Int
  status        AgreementVersionStatus @default(DRAFT)
  /// SHA-256 of the canonical clause + signer content, fixed at send time (tamper evidence).
  contentHash   String?
  sentAt        DateTime?              @db.Timestamptz
  signedAt      DateTime?              @db.Timestamptz
  createdById   String                 @db.Uuid
  createdAt     DateTime               @default(now()) @db.Timestamptz

  agreement Agreement         @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  clauses   AgreementClause[]
  signers   AgreementSigner[]
  events    SignatureEvent[]

  @@unique([agreementId, versionNumber])
  @@index([workspaceId, agreementId])
  @@map("agreement_versions")
}

model AgreementClause {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  versionId   String @db.Uuid
  position    Int
  heading     String
  body        String

  version AgreementVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@index([versionId, position])
  @@map("agreement_clauses")
}

model AgreementSigner {
  id            String       @id @default(uuid()) @db.Uuid
  workspaceId   String       @db.Uuid
  versionId     String       @db.Uuid
  role          SignerRole
  name          String
  email         String
  contactId     String?      @db.Uuid
  signingOrder  Int          @default(1)
  status        SignerStatus @default(PENDING)
  signedAt      DateTime?    @db.Timestamptz
  declinedAt    DateTime?    @db.Timestamptz
  declineReason String?

  version AgreementVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  events  SignatureEvent[]

  @@index([versionId])
  @@map("agreement_signers")
}

model SignatureEvent {
  id             String             @id @default(uuid()) @db.Uuid
  workspaceId    String             @db.Uuid
  versionId      String             @db.Uuid
  signerId       String?            @db.Uuid
  type           SignatureEventType
  method         SignatureMethod    @default(MANUAL_RECORDED)
  occurredAt     DateTime           @db.Timestamptz
  recordedById   String?            @db.Uuid
  evidence       String?
  /// Makes retries and provider webhook redeliveries safe (PRD §7.6, App. B #18).
  idempotencyKey String?
  createdAt      DateTime           @default(now()) @db.Timestamptz

  version AgreementVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  signer  AgreementSigner? @relation(fields: [signerId], references: [id], onDelete: Restrict)

  @@unique([versionId, idempotencyKey])
  @@index([workspaceId, versionId, occurredAt])
  @@map("signature_events")
}

// ───────────────────────── Phase 3: delivery, scope control, change management ─────────────────────────

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

/// Explicit visibility instead of a boolean `is_public` (PRD §4.2).
enum Visibility {
  INTERNAL
  CLIENT_VISIBLE
  SHARED_WITH_SELECTED_CONTACTS
}

/// The delivery container. Created by an explicit action — an engagement never becomes a project by itself.
model Project {
  id           String        @id @default(uuid()) @db.Uuid
  workspaceId  String        @db.Uuid
  clientId     String        @db.Uuid
  engagementId String?       @db.Uuid
  proposalId   String?       @db.Uuid
  agreementId  String?       @db.Uuid
  number       String
  name         String
  description  String?
  status       ProjectStatus @default(PLANNING)
  startDate    DateTime?     @db.Date
  targetDate   DateTime?     @db.Date
  ownerId      String        @db.Uuid
  visibility   Visibility    @default(INTERNAL)
  archivedAt   DateTime?     @db.Timestamptz
  createdAt    DateTime      @default(now()) @db.Timestamptz
  updatedAt    DateTime      @updatedAt @db.Timestamptz

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  engagement     Engagement?     @relation(fields: [engagementId], references: [id], onDelete: Restrict)
  proposal       Proposal?       @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  agreement      Agreement?      @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  scope          ScopeDocument?
  milestones     Milestone[]
  tasks          Task[]
  changeRequests ChangeRequest[]
  invoices       Invoice[]

  @@unique([workspaceId, number])
  @@index([workspaceId, clientId])
  @@index([workspaceId, status])
  @@map("projects")
}

model ScopeDocument {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  projectId   String   @unique @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz

  project  Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  versions ScopeVersion[]

  @@map("scope_documents")
}

enum ScopeVersionStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  SUPERSEDED
}

/// Approved = frozen. The newest APPROVED version is the project's baseline.
model ScopeVersion {
  id              String             @id @default(uuid()) @db.Uuid
  workspaceId     String             @db.Uuid
  scopeDocumentId String             @db.Uuid
  versionNumber   Int
  status          ScopeVersionStatus @default(DRAFT)
  summary         String?
  submittedAt     DateTime?          @db.Timestamptz
  approvedAt      DateTime?          @db.Timestamptz
  createdById     String             @db.Uuid
  createdAt       DateTime           @default(now()) @db.Timestamptz

  document        ScopeDocument   @relation(fields: [scopeDocumentId], references: [id], onDelete: Restrict)
  items           ScopeItem[]
  approval        ScopeApproval?
  changeRequests  ChangeRequest[] @relation("BaseScopeVersion")
  resultOfRequest ChangeRequest?  @relation("ResultingScopeVersion")

  @@unique([scopeDocumentId, versionNumber])
  @@index([workspaceId, scopeDocumentId])
  @@map("scope_versions")
}

enum ScopeItemKind {
  REQUIREMENT
  FEATURE
  DELIVERABLE
  ASSUMPTION
  EXCLUSION
  ACCEPTANCE_CRITERION
}

model ScopeItem {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  versionId   String        @db.Uuid
  /// Stable across versions so the delta between two versions can be computed (renames are changes, not delete + add).
  itemKey     String        @db.Uuid
  kind        ScopeItemKind
  title       String
  description String        @default("")
  position    Int

  version ScopeVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@index([versionId, position])
  @@map("scope_items")
}

enum ScopeDecision {
  APPROVED
  CHANGES_REQUESTED
}

/// References the exact version approved, and never changes (trigger-enforced). Distinct from proposal acceptance
/// and agreement signature (PRD §2 #7).
model ScopeApproval {
  id           String          @id @default(uuid()) @db.Uuid
  workspaceId  String          @db.Uuid
  versionId    String          @unique @db.Uuid
  decision     ScopeDecision
  channel      DecisionChannel @default(OTHER)
  approverName String?
  decidedAt    DateTime        @db.Timestamptz
  recordedById String          @db.Uuid
  note         String?
  createdAt    DateTime        @default(now()) @db.Timestamptz

  version ScopeVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@map("scope_approvals")
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  DELIVERED
  ACCEPTED
}

model Milestone {
  id          String          @id @default(uuid()) @db.Uuid
  workspaceId String          @db.Uuid
  projectId   String          @db.Uuid
  name        String
  description String?
  dueDate     DateTime?       @db.Date
  status      MilestoneStatus @default(PLANNED)
  position    Int             @default(0)
  acceptedAt  DateTime?       @db.Timestamptz
  createdAt   DateTime        @default(now()) @db.Timestamptz
  updatedAt   DateTime        @updatedAt @db.Timestamptz

  project      Project                @relation(fields: [projectId], references: [id], onDelete: Restrict)
  deliverables MilestoneDeliverable[]
  tasks        Task[]
  invoices     Invoice[]

  @@index([workspaceId, projectId, position])
  @@map("milestones")
}

model MilestoneDeliverable {
  id           String  @id @default(uuid()) @db.Uuid
  workspaceId  String  @db.Uuid
  milestoneId  String  @db.Uuid
  title        String
  /// Optional link to the scope deliverable this satisfies.
  scopeItemKey String? @db.Uuid
  done         Boolean @default(false)
  position     Int     @default(0)

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Restrict)

  @@index([milestoneId, position])
  @@map("milestone_deliverables")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id            String       @id @default(uuid()) @db.Uuid
  workspaceId   String       @db.Uuid
  projectId     String       @db.Uuid
  milestoneId   String?      @db.Uuid
  title         String
  description   String?
  /// Never returned by any client-facing endpoint (PRD §7.8).
  internalNotes String?
  priority      TaskPriority @default(MEDIUM)
  status        TaskStatus   @default(TODO)
  dueDate       DateTime?    @db.Date
  position      Int          @default(0)
  visibility    Visibility   @default(INTERNAL)
  completedAt   DateTime?    @db.Timestamptz
  createdById   String       @db.Uuid
  createdAt     DateTime     @default(now()) @db.Timestamptz
  updatedAt     DateTime     @updatedAt @db.Timestamptz

  project      Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  milestone    Milestone?       @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  dependsOn    TaskDependency[] @relation("Dependent")
  dependedOnBy TaskDependency[] @relation("Dependency")

  @@index([workspaceId, projectId, status])
  @@index([projectId, milestoneId, position])
  @@map("tasks")
}

model TaskDependency {
  id              String @id @default(uuid()) @db.Uuid
  workspaceId     String @db.Uuid
  taskId          String @db.Uuid
  dependsOnTaskId String @db.Uuid

  task      Task @relation("Dependent", fields: [taskId], references: [id], onDelete: Restrict)
  dependsOn Task @relation("Dependency", fields: [dependsOnTaskId], references: [id], onDelete: Restrict)

  @@unique([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
  @@map("task_dependencies")
}

enum ChangeRequestStatus {
  SUBMITTED
  NEEDS_CLARIFICATION
  ASSESSED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum RequesterType {
  FREELANCER
  CLIENT
}

/// Approving a change never silently amends a signed agreement (PRD §7.9). Where terms require it, the addendum
/// must be completed before the changed work begins.
enum AddendumStatus {
  NOT_REQUIRED
  REQUIRED
  COMPLETED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum ChangeParty {
  FREELANCER
  CLIENT
}

enum ChangeDecisionKind {
  APPROVED
  REJECTED
  CLARIFICATION_REQUESTED
}

model ChangeRequest {
  id                      String              @id @default(uuid()) @db.Uuid
  workspaceId             String              @db.Uuid
  projectId               String              @db.Uuid
  number                  String
  title                   String
  description             String
  reason                  String
  requestedBy             RequesterType
  requesterName           String?
  requestedAt             DateTime            @db.Date
  status                  ChangeRequestStatus @default(SUBMITTED)
  /// The approved scope this request seeks to change. A rejected request never alters it.
  baseScopeVersionId      String              @db.Uuid
  /// Draft scope version created when the request is approved; the owner edits it to apply the change.
  resultingScopeVersionId String?             @unique @db.Uuid
  addendumStatus          AddendumStatus      @default(NOT_REQUIRED)
  addendumNote            String?
  addendumAgreementId     String?             @db.Uuid
  addendumCompletedAt     DateTime?           @db.Timestamptz
  withdrawnReason         String?
  createdById             String              @db.Uuid
  createdAt               DateTime            @default(now()) @db.Timestamptz
  updatedAt               DateTime            @updatedAt @db.Timestamptz

  project          Project                   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  baseScopeVersion ScopeVersion              @relation("BaseScopeVersion", fields: [baseScopeVersionId], references: [id], onDelete: Restrict)
  resultingVersion ScopeVersion?             @relation("ResultingScopeVersion", fields: [resultingScopeVersionId], references: [id], onDelete: Restrict)
  assessments      ChangeRequestAssessment[]
  decisions        ChangeRequestDecision[]
  invoices         Invoice[]

  @@unique([projectId, number])
  @@index([workspaceId, projectId, status])
  @@map("change_requests")
}

/// Append-only: re-assessing adds a row; the latest wins and the history is kept.
model ChangeRequestAssessment {
  id                 String    @id @default(uuid()) @db.Uuid
  workspaceId        String    @db.Uuid
  changeRequestId    String    @db.Uuid
  /// Signed: negative means a saving.
  costDeltaMinor     BigInt
  currency           String    @db.Char(3)
  timelineDeltaDays  Int
  deliverablesImpact String
  dependenciesImpact String
  risk               RiskLevel
  riskNotes          String?
  requiresAddendum   Boolean
  assessedById       String    @db.Uuid
  createdAt          DateTime  @default(now()) @db.Timestamptz

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Restrict)

  @@index([changeRequestId, createdAt])
  @@map("change_request_assessments")
}

/// Append-only record of each party's decision.
model ChangeRequestDecision {
  id              String             @id @default(uuid()) @db.Uuid
  workspaceId     String             @db.Uuid
  changeRequestId String             @db.Uuid
  party           ChangeParty
  decision        ChangeDecisionKind
  channel         DecisionChannel    @default(OTHER)
  decidedAt       DateTime           @db.Timestamptz
  recordedById    String             @db.Uuid
  note            String?
  createdAt       DateTime           @default(now()) @db.Timestamptz

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Restrict)

  @@index([changeRequestId, createdAt])
  @@map("change_request_decisions")
}

// ───────────────────────── Phase 4: finance ─────────────────────────
//
// Money is BigInt minor units + a currency code. Balances are never stored: they are derived from allocations and
// credit notes, so a number on screen can always be traced to the records behind it (PRD §7.3, §9.14).

/// Stored lifecycle only. PARTIALLY_PAID / PAID / OVERDUE / CREDITED are derived from allocations and credit notes.
enum InvoiceStatus {
  DRAFT
  ISSUED
  VOID
}

enum PaymentMethod {
  BANK_TRANSFER
  UPI
  CARD
  CASH
  CHEQUE
  OTHER
}

/// A draft has no number: the number is reserved at issue, inside the same transaction, so numbering stays gap-free.
model Invoice {
  id               String        @id @default(uuid()) @db.Uuid
  workspaceId      String        @db.Uuid
  clientId         String        @db.Uuid
  projectId        String?       @db.Uuid
  milestoneId      String?       @db.Uuid
  changeRequestId  String?       @db.Uuid
  number           String?
  status           InvoiceStatus @default(DRAFT)
  currency         String        @db.Char(3)
  issueDate        DateTime?     @db.Date
  dueDate          DateTime?     @db.Date
  paymentTermsDays Int           @default(30)
  notes            String?
  /// Parties as they were at issue. Later edits to the client or business profile never rewrite an issued invoice.
  supplierName     String?
  supplierTaxId    String?
  supplierAddress  String?
  billToName       String?
  billToTaxId      String?
  billToAddress    String?
  subtotalMinor    BigInt        @default(0)
  discountMinor    BigInt        @default(0)
  taxMinor         BigInt        @default(0)
  totalMinor       BigInt        @default(0)
  issuedAt         DateTime?     @db.Timestamptz
  issuedById       String?       @db.Uuid
  voidedAt         DateTime?     @db.Timestamptz
  voidReason       String?
  visibility       Visibility    @default(INTERNAL)
  sharedAt         DateTime?     @db.Timestamptz
  createdById      String        @db.Uuid
  createdAt        DateTime      @default(now()) @db.Timestamptz
  updatedAt        DateTime      @updatedAt @db.Timestamptz

  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  client        Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project       Project?            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  milestone     Milestone?          @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  changeRequest ChangeRequest?      @relation(fields: [changeRequestId], references: [id], onDelete: Restrict)
  lines         InvoiceLine[]
  allocations   PaymentAllocation[]
  creditNotes   CreditNote[]

  @@unique([workspaceId, number])
  @@index([workspaceId, clientId, status])
  @@index([workspaceId, status, dueDate])
  @@map("invoices")
}

model InvoiceLine {
  id            String  @id @default(uuid()) @db.Uuid
  workspaceId   String  @db.Uuid
  invoiceId     String  @db.Uuid
  position      Int
  description   String
  quantity      Decimal @db.Decimal(18, 4)
  unitLabel     String  @default("unit")
  unitRateMinor BigInt
  discountBps   Int     @default(0)
  taxBps        Int     @default(0)
  netMinor      BigInt
  taxMinor      BigInt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId, position])
  @@map("invoice_lines")
}

/// Money received. Never edited or deleted: a mistake is corrected by reversing it (PRD §7.10).
model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  workspaceId    String        @db.Uuid
  clientId       String        @db.Uuid
  amountMinor    BigInt
  currency       String        @db.Char(3)
  receivedAt     DateTime      @db.Date
  method         PaymentMethod @default(BANK_TRANSFER)
  reference      String?
  note           String?
  /// Makes a retried request return the original payment instead of recording it twice.
  idempotencyKey String?
  reversedAt     DateTime?     @db.Timestamptz
  reversedById   String?       @db.Uuid
  reversalReason String?
  createdById    String        @db.Uuid
  createdAt      DateTime      @default(now()) @db.Timestamptz

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  client      Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  allocations PaymentAllocation[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, clientId, receivedAt])
  @@map("payments")
}

/// Append-only. One payment may be split across many invoices; one invoice may receive many partial payments.
model PaymentAllocation {
  id               String   @id @default(uuid()) @db.Uuid
  workspaceId      String   @db.Uuid
  paymentId        String   @db.Uuid
  invoiceId        String   @db.Uuid
  /// Cash taken from the payment.
  amountMinor      BigInt
  /// Tax the payer withheld (e.g. TDS). Settles the invoice but is not cash from this payment.
  withholdingMinor BigInt   @default(0)
  createdById      String   @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([paymentId])
  @@map("payment_allocations")
}

/// The correction path for an issued invoice (PRD §7.10): append-only, numbered, reduces the outstanding balance.
model CreditNote {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  invoiceId   String   @db.Uuid
  number      String
  amountMinor BigInt
  currency    String   @db.Char(3)
  reason      String
  issuedAt    DateTime @db.Date
  createdById String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, number])
  @@index([invoiceId])
  @@map("credit_notes")
}
