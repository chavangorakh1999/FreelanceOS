# Copy to .env for local development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/freelanceos?schema=public"
JWT_ACCESS_SECRET="change-me-to-a-long-random-string-min-32-chars"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
WEB_ORIGIN="http://localhost:3000"
PORT=4000

# Email. "log" prints messages instead of sending (development). "smtp" works with any transactional provider's SMTP.
EMAIL_PROVIDER=log
# SMTP_URL="smtps://user:password@smtp.example.com:465"
EMAIL_FROM="FreelanceOS <no-reply@example.com>"
# Set to "off" to stop the in-process outbox/reminder loop (e.g. when a separate worker runs it).
EMAIL_WORKER=on

# Private document storage (never served directly) and the upload size limit.
STORAGE_DIR=./var/storage
MAX_UPLOAD_MB=20

# Monitoring. /metrics is disabled unless this is set (at least 16 characters); scrape it with this bearer token.
# METRICS_TOKEN=
# Set to "off" to silence the one-line-per-request JSON access log.
LOG_REQUESTS=on

# Public address of this API, used for gateway webhooks (Cashfree calls https endpoints only).
API_PUBLIC_URL=https://api.example.com
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts gateway secrets at rest. Keep it with your backups:
# without it, saved Cashfree keys must be entered again.
SECRETS_KEY=
