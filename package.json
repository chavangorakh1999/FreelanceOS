{
  "name": "freelanceos",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev:api": "pnpm --filter @freelanceos/api start:dev",
    "dev:web": "pnpm --filter @freelanceos/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @freelanceos/api prisma:generate",
    "db:migrate": "pnpm --filter @freelanceos/api prisma:migrate"
  }
}
